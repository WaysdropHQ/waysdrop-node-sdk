{
    "name": "@waysdrop/sdk",
    "version": "1.0.1",
    "description": "Official Waysdrop Partner API SDK for Node.js",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./webhooks": {
            "types": "./dist/webhooks.d.ts",
            "import": "./dist/webhooks.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node --test tests/*.test.mjs",
        "prepublishOnly": "npm run build && npm test"
    },
    "engines": {
        "node": ">=18"
    },
    "keywords": [
        "waysdrop",
        "delivery",
        "api",
        "sdk"
    ],
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^22.10.0",
        "typescript": "^5.7.2"
    }
}
